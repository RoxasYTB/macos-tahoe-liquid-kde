+        const QMenu *menu = qobject_cast<const QMenu*>(widget);
+        const QMenu *parentMenu = menu != nullptr
+            ? qobject_cast<const QMenu*>(menu->parentWidget())
+            : nullptr;
+        const bool isSubmenu = parentMenu != nullptr && parentMenu != menu;
+        const QRect itemGlobal = menu
+            ? QRect(menu->mapToGlobal(option->rect.topLeft()), option->rect.size())
+            : QRect();
+        const bool pointerHover = (option->state & State_MouseOver)
+            || (menu != nullptr && itemGlobal.contains(QCursor::pos()));
+        if (isSubmenu && pointerHover && parentMenu != nullptr)
+        {
+          for (QAction *parentAction : parentMenu->actions())
+          {
+            if (parentAction->menu() == menu)
+            {
+              const_cast<QMenu*>(parentMenu)->update(parentMenu->actionGeometry(parentAction));
+              break;
+            }
+          }
+        }
+        bool openSubmenuRow = false;
+        if (menu != nullptr && !isSubmenu)
+        {
+          for (QAction *action : menu->actions())
+          {
+            const QRect actionRect = menu->actionGeometry(action);
+            if (action->menu() != nullptr && action->menu()->isVisible()
+                && actionRect.top() <= option->rect.center().y()
+                && actionRect.bottom() >= option->rect.center().y())
+            {
+              openSubmenuRow = true;
+              break;
+            }
+          }
+        }
+        if (openSubmenuRow)
+          status = KL1("normal");
@@ -5783,0 +5823,21 @@
