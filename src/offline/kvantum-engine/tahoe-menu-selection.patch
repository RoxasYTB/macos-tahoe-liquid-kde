+      const QMenu *parentMenu = menu != nullptr
+          ? qobject_cast<const QMenu*>(menu->parentWidget())
+          : nullptr;
+      if (menu != nullptr && parentMenu != nullptr && parentMenu != menu)
+      {
+        const QRect parentGlobal(parentMenu->mapToGlobal(QPoint(0, 0)), parentMenu->size());
+        const QRect childGlobal(menu->mapToGlobal(QPoint(0, 0)), menu->size());
+        const QRect shared = parentGlobal.intersected(childGlobal);
+        if (shared.width() > 1 && shared.height() > 1)
+          panelClip -= QRegion(shared.translated(-childGlobal.topLeft()));
+      }
+      painter->save();
+      painter->setClipRegion(panelClip, Qt::IntersectClip);
