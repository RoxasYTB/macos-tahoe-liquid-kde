+// QAction ownership also identifies detached native Qt submenus before show.
+const QMenu *menuParent(const QMenu *menu, bool requireVisible = true)
+{
+  if (!menu)
+    return nullptr;
+  const auto ownsMenu = [menu, requireVisible](const QMenu *candidate) {
+    if (!candidate || candidate == menu || (requireVisible && !candidate->isVisible()))
+      return false;
+    for (QAction *action : candidate->actions())
+      if (action->menu() == menu)
+        return true;
+    return false;
+  };
+  const QMenu *parent = qobject_cast<const QMenu*>(menu->parentWidget());
+  if (ownsMenu(parent))
+    return parent;
+  if (menu->menuAction())
+    for (QObject *associated : menu->menuAction()->associatedObjects())
+      if (const QMenu *candidate = qobject_cast<const QMenu*>(associated); ownsMenu(candidate))
+        return candidate;
+  return nullptr;
+}
